NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://neev:neev@localhost:5432/neev?schema=public
DATABASE_SSL_MODE=prefer
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT_SECONDS=10
REDIS_URL=redis://localhost:6379
# Optional encrypted MongoDB document store. Generate the key with: openssl rand -base64 32
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
MONGODB_DATABASE=neev
MONGODB_POOL_SIZE=10
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_TLS=true
# MONGODB_ENCRYPTION_KEY=
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=neev-api
JWT_AUDIENCE=neev-web
JWT_CLOCK_TOLERANCE_SECONDS=5
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_REFRESH_COOKIE_NAME=neev_refresh
AUTH_COOKIE_SECURE=false
AUTH_REQUIRE_USER_LOOKUP=true
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
PAYMENT_WEBHOOK_SECRET=replace-with-a-provider-webhook-secret
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=900
WEB_ORIGIN=http://localhost:3000
MAX_JSON_BODY_BYTES=65536
MAX_URLENCODED_BODY_BYTES=32768
MAX_MULTIPART_BODY_BYTES=5242880
MAX_WEBHOOK_BODY_BYTES=262144
MAX_WS_MESSAGE_BYTES=65536
STARTUP_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000
HEALTH_CHECK_TIMEOUT_MS=5000
RATE_LIMIT_STORE=memory
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX_REQUESTS=10
TRUST_PROXY=0
RUN_WORKERS=true
RECONCILIATION_SWEEP_INTERVAL_SECONDS=300
IDEMPOTENCY_TTL_SECONDS=86400
SEED_ON_START=false
SEED_TIMEOUT_MS=120000
SEED_LOCK_LEASE_MS=300000
LOG_LEVEL=info
